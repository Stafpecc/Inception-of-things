Vagrant.configure(2) do |config|

    SERVER_IP = "192.168.56.110"

    NODES = [
        { :hostname => "tariniS", :ip => SERVER_IP, :cpus => 1, :mem => 1024, :type => "server"},
        { :hostname => "tariniSW", :ip => "192.168.56.111", :cpus => 1, :mem => 1024, :type => "agent" }
    ]

    config.vm.box = "ubuntu-jammy-official"
    config.vm.box_url = "https://cloud-images.ubuntu.com/jammy/current/jammy-server-cloudimg-amd64-vagrant.box"

    NODES.each do |node|
        config.vm.define node[:hostname] do |cfg|
            cfg.vm.hostname = node[:hostname]
            cfg.vm.network "private_network", ip: node[:ip]

            cfg.vm.provider "virtualbox" do |v|
                v.name = node[:hostname]
                v.cpus = node[:cpus]
                v.memory = node[:mem]
                v.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
                v.customize ["modifyvm", :id, "--natdnsproxy1", "on"]
            end

            cfg.vm.provision "shell", inline: "ethtool -K enp0s8 tx off rx off gso off gro off tso off", run: "always"

            env = { "SERVER_IP" => SERVER_IP, "NODE_IP" => node[:ip] }
            if node[:type] == "server"
                cfg.vm.provision "shell", path: "scripts/install_k3s_server.sh", env: env
            else
                cfg.vm.provision "shell", path: "scripts/install_k3s_agent.sh", env: env
            end
        end
    end
end
